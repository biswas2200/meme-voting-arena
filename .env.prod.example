# =============================================================
# .env.prod.example — Production (AWS) Reference
#
# Copy this file to .env.prod and fill in REAL values for
# local smoke-testing the production image:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build
#
# In actual AWS deployment these values live in:
#   - AWS Secrets Manager  (JWT_SECRET, DB credentials)
#   - ECS Task Definition  (environment variables section)
#
# NEVER commit .env.prod — it contains real secrets.
# =============================================================

# AWS RDS PostgreSQL
# Format: jdbc:postgresql://<rds-endpoint>:5432/<db-name>?sslmode=require
DATABASE_URL=jdbc:postgresql://your-rds-endpoint.rds.amazonaws.com:5432/meme_arena?sslmode=require
DATABASE_USERNAME=meme_user
DATABASE_PASSWORD=your_strong_rds_password

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_real_256bit_secret_generated_by_openssl
JWT_EXPIRATION_MS=86400000

# CORS — your CloudFront or Amplify frontend URL (no trailing slash)
CORS_ORIGINS=https://your-cloudfront-domain.cloudfront.net

# Frontend API URL (used at Docker build time for the prod image)
REACT_APP_API_URL=https://your-alb-domain.amazonaws.com

# Docker image tag (used for ECR tagging)
IMAGE_TAG=latest
