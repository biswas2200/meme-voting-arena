# =============================================================
# .env.prod.example — Production Reference
#
# Copy this file to .env.prod and fill in REAL values for
# local smoke-testing the production image:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build
#
# In a real deployment these values should live in whatever secret
# store / environment-variable mechanism your hosting platform provides —
# never hardcoded into an image or committed to source control.
#
# NEVER commit .env.prod — it contains real secrets.
# =============================================================

# Production PostgreSQL
# Format: jdbc:postgresql://<host>:5432/<db-name>?sslmode=require
DATABASE_URL=jdbc:postgresql://your-postgres-host:5432/meme_arena?sslmode=require
DATABASE_USERNAME=meme_user
DATABASE_PASSWORD=your_strong_db_password

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_real_256bit_secret_generated_by_openssl
JWT_EXPIRATION_MS=86400000

# CORS — your deployed frontend URL (no trailing slash)
CORS_ORIGINS=https://your-frontend-domain.example.com

# Frontend API URL (used at Docker build time for the prod image)
REACT_APP_API_URL=https://your-backend-domain.example.com

# Docker image tag
IMAGE_TAG=latest
