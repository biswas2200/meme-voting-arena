# =============================================================
# .env.dev.example — Local Docker Development
#
# Copy this file to .env.dev and fill in values:
#   cp .env.dev.example .env.dev
#
# Then start the stack:
#   docker compose --env-file .env.dev up --build
#
# .env.dev is git-ignored — never commit it.
# =============================================================

# PostgreSQL container credentials
POSTGRES_DB=meme_arena
POSTGRES_USER=meme_user
POSTGRES_PASSWORD=meme_pass

# JWT — any string works for local dev, min 32 chars
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars_here
JWT_EXPIRATION_MS=86400000
