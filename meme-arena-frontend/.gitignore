# ─────────────────────────────────────────────────────────────
# Frontend-specific gitignore
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/

# Build output
build/
dist/

# Vite cache
.vite/

# Local env files (contain machine-specific or secret values)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/

# OS
.DS_Store
Thumbs.db
